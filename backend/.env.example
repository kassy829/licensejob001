# LINE
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret
LIFF_ID_JOB_SEARCH=your_liff_id_job_search
LIFF_ID_MYPAGE=your_liff_id_mypage

# ハローワーク API
HELLOWORK_API_BASE_URL=https://api.hellowork.mhlw.go.jp/v1
HELLOWORK_API_KEY=your_hellowork_api_key

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/licensejob

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://your-liff-app.vercel.app

# 警察庁 外免切替 ページ監視
# 通知先LINE ユーザーID（STAFF_LINE_USER_ID を流用）
STAFF_LINE_USER_ID=your_staff_line_user_id
# 監視対象URL（省略時はデフォルトの警察庁ページ）
POLICE_MONITOR_URL=https://www.npa.go.jp/policies/application/license_renewal/gaimen.html
# cron スケジュール（省略時: 毎日 9:00 と 15:00 JST）
POLICE_MONITOR_CRON=0 0,6 * * *
